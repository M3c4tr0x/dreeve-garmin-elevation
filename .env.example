# Copier en .env, a cote de docker-compose.yml, puis adapter.

# Adresse du compte Garmin Connect (obligatoire). Le mot de passe n'est JAMAIS ecrit ici :
# il est demande une seule fois au login (voir README.fr.md).
GARMIN_EMAIL=vous@example.com

# Dossier watch de Dreeve, cote hote : celui monte sur /var/www/watch dans le conteneur Dreeve
# (obligatoire, chemin absolu de preference). Pour le trouver, voir l'etape 1 de README.fr.md.
DREEVE_WATCH_DIR=/chemin/vers/dreeve/watch

# Premiere date a recuperer. 'now' : seulement les nouvelles sorties (conseille si Dreeve
# contient deja l'historique, car il ignore les doublons).
SINCE=now

TZ=Europe/Paris
